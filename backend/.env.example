# Copy to backend/.env and/or repo-root .env (never commit real secrets).
# core/config.py reads these keys — defaults live here only, not in Python.

# PostgreSQL (psycopg)
DATABASE_URL=
# Alembic migrations (optional; Neon 등 pooler 우회용 direct endpoint)
DIRECT_URL=

# Redis (optional session cache)
REDIS_URL=

# Outbound API keys (Anthropic Claude + Cohere embeddings)
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Model IDs — optional, defaults below match what's currently deployed.
# See infrastructure/config.py for which adapter/outbound/client/*.py file
# each one drives.
CLAUDE_MODEL_ID=claude-sonnet-5
LORE_CHAT_MODEL_ID=claude-haiku-4-5-20251001
COHERE_EMBED_MODEL=embed-v4.0

# Portia response provider: "claude" (default) or "local" (Ollama, with
# automatic Claude fallback on failure/timeout — see portia_response_provider.py).
# Leave unset/"claude" unless you're intentionally testing local serving.
LLM_PROVIDER=claude
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b-mlx
OLLAMA_TIMEOUT_SECONDS=15
# Only needed when OLLAMA_BASE_URL is a public Cloudflare Tunnel hostname
# gated by a Cloudflare Access "Service Auth" policy (e.g. the home Mac
# tunnel) — leave blank for local dev / plain localhost Ollama.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Evidence search embedding backend: "cohere" (default) or "local" (e5 over
# HTTP via embed_main.py on the home Mac, same Cloudflare Tunnel
# pattern as Ollama, with automatic Cohere fallback — see
# evidence_search_provider.py). Needs alembic head (029/030) applied +
# backfill_local_embeddings.py run first, AND the Mac server actually running
# + tunneled. Leave unset/"cohere" unless you're intentionally testing local
# embeddings.
EMBEDDING_PROVIDER=cohere
# LOCAL_EMBEDDING_MODEL: read by embed_main.py (the Mac process
# that loads the model), not by the EC2 backend. Optional — default already
# matches the model the 1024-dim column/index/backfill were built for.
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
# embed_main.py address. localhost:8001 for local dev running the
# server directly; the real Cloudflare Tunnel hostname once that's set up.
LOCAL_EMBEDDING_BASE_URL=http://localhost:8001
LOCAL_EMBEDDING_TIMEOUT_SECONDS=10
# Own Service Token for LOCAL_EMBEDDING_BASE_URL's Access Application — not
# the same token as CF_ACCESS_CLIENT_ID/SECRET above, even though both
# tunnel through the same home Mac (so a leaked/rotated token only takes
# down one of the two services). Leave blank for local dev / plain localhost.
LOCAL_EMBEDDING_CF_ACCESS_CLIENT_ID=
LOCAL_EMBEDDING_CF_ACCESS_CLIENT_SECRET=

# HMAC secret for /docs login session cookie (optional; has a weak default for local)
DOCS_SESSION_SECRET=change-me-docs-session-secret

# Admin credentials for Swagger /docs login
DOCS_ADMIN_USERNAME=admin
DOCS_ADMIN_PASSWORD=change-me-docs-admin-password

# HMAC secret for game user login session cookies
AUTH_SESSION_SECRET=change-me-auth-session-secret

# Google OAuth login (console.cloud.google.com; empty values disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/shylock-trial/auth/google/callback
# Frontend origin to return to after social login
FRONTEND_BASE_URL=http://localhost:3000

# App
APP_ENV=development
LOG_LEVEL=INFO

# Dev without PostgreSQL: set true (trials lost on backend restart)
# Docker Compose overrides this to false and uses Postgres.
USE_MEMORY_STORE=true

# Frontend CORS (comma-separated; include production frontend domains)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://shylock-trial.xyz,https://www.shylock-trial.xyz
