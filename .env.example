# Repo root .env — required by `docker compose up` for the cloudflared service
# (docker-compose.yaml → cloudflared → env_file: .env). This file is gitignored;
# copy it to `.env` on every host that runs docker compose (including deploy
# servers) and fill in real values. It is NOT distributed by git pull/clone.

# Cloudflare Tunnel connector token
# (Zero Trust → Networks → Tunnels → your tunnel → Install connector)
TUNNEL_TOKEN=

# Only needed if you run the backend directly with `uvicorn` outside Docker
# (infrastructure/config.py falls back to reading this file in that case).
# When running via `docker compose`, backend/auth read .env.backend/.env.auth
# instead — you do not need to duplicate those values here for deploys.
APP_ENV=production
LOG_LEVEL=INFO
USE_MEMORY_STORE=false

DATABASE_URL=
DIRECT_URL=
REDIS_URL=

ANTHROPIC_API_KEY=
COHERE_API_KEY=

CORS_ORIGINS=
